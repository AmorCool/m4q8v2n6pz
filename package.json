{
    "name": "thunderx-rebuild",
    "version": "0.1.0",
    "description": "Thunder (Xunlei) desktop client rebuild",
    "private": true,
    "main": "src/main/electron-main.js",
    "scripts": {
        "start": "electron .",
        "start:headless": "cross-env TL_OUTPUT=console node src/main/index.js",
        "test": "node scripts/smoke.js",
        "engine:fetch": "node scripts/fetch-engine.js",
        "engine:list": "node scripts/fetch-engine.js --list",
        "pack": "npm run engine:fetch && electron-builder --win --x64 --dir",
        "dist": "npm run engine:fetch && electron-builder --win --x64",
        "lint": "node --check src/main/contract.js && node --check src/main/rpc.js && node --check src/main/kernel.js && node --check src/main/login.js && node --check src/main/vip-token.js && node --check src/main/plugin-host.js && node --check src/main/engine-aria2.js && node --check src/main/index.js && node --check src/main/electron-main.js && node --check src/preload/index.js && node --check src/renderer/index.js && node --check scripts/fetch-engine.js"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {},
    "devDependencies": {
        "cross-env": "^7.0.3",
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.thunderx.rebuild",
        "productName": "ThunderX",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "config/app.json",
            "package.json",
            "!**/*.log"
        ],
        "extraResources": [
            {
                "from": "bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false,
            "artifactName": "ThunderX-${version}-setup.${ext}"
        }
    },
    "keywords": [
        "thunder",
        "xunlei",
        "electron",
        "download"
    ],
    "license": "UNLICENSED"
}
